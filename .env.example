# LLM Provider (claude, siliconflow, deepseek, moonshot)
LLM_PROVIDER=claude

# API Keys (只需配置你使用的提供商)
ANTHROPIC_API_KEY=your_anthropic_key_here
SILICONFLOW_API_KEY=your_siliconflow_key_here
DEEPSEEK_API_KEY=your_deepseek_key_here
MOONSHOT_API_KEY=your_moonshot_key_here

# Model Settings (可选，使用默认值)
# CLAUDE_MODEL=claude-3-5-sonnet-20241022
# SILICONFLOW_MODEL=Qwen/Qwen2.5-7B-Instruct
# DEEPSEEK_MODEL=deepseek-chat
# MOONSHOT_MODEL=moonshot-v1-8k

# OpenAI-compatible base URLs used by LiteLLM
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1

# Generation Settings
# MAX_TOKENS=4096
# TEMPERATURE=0.7
# LLM_TIMEOUT_SECONDS=120

# Chat Agent
# CHAT_PLAN_ENABLED=true

# Database
DATABASE_URL=sqlite:///./data/content_ops.db
# Production example:
# DATABASE_URL=postgresql+psycopg://content_ops:content_ops@localhost:5432/content_ops
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# DB_POOL_TIMEOUT_SECONDS=30

# Background Jobs
# JOB_QUEUE_MODE=background
# Production example:
# JOB_QUEUE_MODE=rq
# REDIS_URL=redis://localhost:6379/0
# JOB_QUEUE_NAME=content_ops
# JOB_TIMEOUT_SECONDS=300
# MAX_PROVIDER_INFLIGHT_JOBS=8

# Media + Xiaohongshu MCP
# MEDIA_STORAGE_ROOT=data/media
# MEDIA_MAX_IMAGE_COUNT=9
# MEDIA_MAX_VIDEO_SIZE_MB=512
# XHS_MCP_ENABLED=true
# XHS_MCP_URL=http://127.0.0.1:18060/mcp
# XHS_MCP_TIMEOUT_SECONDS=120

# API / App Settings
DEBUG=True
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173
