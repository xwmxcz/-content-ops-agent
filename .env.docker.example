# Docker Compose is the production profile. It refuses to start until all
# CHANGE_ME values below are replaced. The frontend binds only to loopback;
# a TLS reverse proxy must expose it and send X-Forwarded-Proto: https.
# Fill at least one provider key before using real LLM features.

# LLM Provider (claude, siliconflow, deepseek, moonshot, newapi)
LLM_PROVIDER=deepseek

# API Keys
ANTHROPIC_API_KEY=
SILICONFLOW_API_KEY=
DEEPSEEK_API_KEY=your_deepseek_key_here
MOONSHOT_API_KEY=
NEWAPI_API_KEY=
NEWAPI_BASE_URL=

# Optional model overrides
# CLAUDE_MODEL=claude-3-5-sonnet-20241022
# SILICONFLOW_MODEL=zai-org/GLM-4.5-Air
# DEEPSEEK_MODEL=deepseek-v4-flash
# MOONSHOT_MODEL=moonshot-v1-8k
# NEWAPI_MODEL=gpt-4o-mini

# App-facing ports are defined in docker-compose.yml:
# - Frontend upstream (loopback only): http://127.0.0.1:8088
# - API diagnostics (loopback only):   http://127.0.0.1:8000
FRONTEND_PORT=8088

# Production fail-closed credentials. Generate independent random values, e.g.
# `openssl rand -base64 24` and `openssl rand -hex 32`.
AUTH_ENABLED=true
AUTH_USERNAME=admin
AUTH_PASSWORD=CHANGE_ME_WITH_A_RANDOM_ADMIN_PASSWORD
AUTH_SECRET_KEY=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_BYTES
AUTH_TOKEN_EXPIRE_MINUTES=1440
AUTH_RESOURCE_TICKET_SECONDS=45
AUTH_MEDIA_TICKET_SECONDS=300
POSTGRES_PASSWORD=CHANGE_ME_WITH_A_RANDOM_POSTGRES_PASSWORD
REDIS_PASSWORD=CHANGE_ME_WITH_A_RANDOM_REDIS_PASSWORD

# Container runtime settings. Compose deliberately overrides DATABASE_URL,
# JOB_QUEUE_MODE, REDIS_URL, MEDIA_STORAGE_ROOT, and MEMORY_DIR so service names
# and mounted volumes work inside Docker.
MAX_PROVIDER_INFLIGHT_JOBS=8
DEBUG=false
ENFORCE_HTTPS=true
# API accepts X-Forwarded-Proto only from this private proxy network.
TRUSTED_PROXY_CIDRS=172.16.0.0/12
LOG_LEVEL=INFO
# Exact public browser origin; production validation requires HTTPS.
CORS_ORIGINS=https://CHANGE_ME.example.com

# Web search provider for researcher/fact-checker tools.
# Recommended for reliable search: set one API key and keep provider=auto.
WEB_SEARCH_PROVIDER=auto
SERPER_API_KEY=
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
SEARXNG_BASE_URL=

# If your Xiaohongshu MCP server runs on the Windows/macOS host, keep this URL.
# On Linux, host.docker.internal may require Docker Engine 20.10+.
XHS_MCP_URL=http://host.docker.internal:18060/mcp
